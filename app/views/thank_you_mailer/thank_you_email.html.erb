<%= email_page :slate, icon: 'heart', label: 'Thank you', title: 'Thank you for joining us', tagline: @event.title %>
<p>Dear <%= @ticket.attendee_name.presence || 'friend' %>,</p>
<p>It was a pleasure to welcome you to <strong><%= @event.title %></strong>. An event is only as special as the people who attend, and your presence made a real difference.</p>
<p>We hope you left with something to remember, whether a new idea, a new connection, or simply a day well spent.</p>

<% if @feedback_url %>
  <%= render 'emails/callout', title: "We'd love to hear from you",
        text: (@certificate_for_feedback ? 'Share your feedback and your e-certificate will be emailed to you right after. It only takes a minute.' : 'Your thoughts help us make the next event even better, and it only takes a minute.') %>
  <%= render 'emails/buttons', primary: ['Share Your Feedback', @feedback_url] %>
<% end %>

<% if @contact_email.present? %>
  <p style="margin-top:28px">If there is anything else you would like to tell us, please write to <%= mail_to @contact_email, nil, class: 'link' %>.</p>
<% end %>
<p>Until we meet again, take care, and we hope to see you soon.</p>
<%= render 'emails/signoff', closing: 'With gratitude,', name: @sender_name %>
