<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; background: #f0f4f8; margin: 0; padding: 0; }
    .wrapper { padding: 40px 20px; }
    .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #b45309, #d97706); color: white; padding: 40px 30px; text-align: center; }
    .header h1 { margin: 0 0 8px; font-size: 28px; letter-spacing: -0.5px; }
    .header p { margin: 0; font-size: 16px; opacity: 0.9; }
    .content { padding: 32px 30px; }
    .greeting { font-size: 16px; margin-bottom: 16px; }
    .message { font-size: 15px; color: #555; margin-bottom: 20px; line-height: 1.7; }
    .feedback { text-align: center; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 28px 20px; margin: 8px 0 24px; }
    .feedback h3 { margin: 0 0 8px; font-size: 17px; color: #92400e; }
    .feedback p { margin: 0 0 20px; font-size: 14px; color: #92400e; }
    .button { display: inline-block; background: #d97706; color: #ffffff !important; text-decoration: none; font-weight: bold; padding: 12px 28px; border-radius: 8px; font-size: 15px; }
    .closing { font-size: 15px; color: #555; line-height: 1.7; margin-bottom: 8px; }
    .signature { font-size: 15px; color: #333; font-weight: bold; }
    .footer { background: #f8fafc; border-top: 1px solid #e2e8f0; text-align: center; padding: 20px 30px; font-size: 12px; color: #999; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <h1>We'd Love Your Feedback</h1>
        <p><%= @event.title %></p>
      </div>

      <div class="content">
        <p class="greeting">Dear <strong><%= @ticket.attendee_name.presence || 'friend' %></strong>,</p>

        <p class="message">
          Thank you again for joining us at <strong><%= @event.title %></strong>. We noticed we haven't received your feedback yet, and your voice really matters to us.
        </p>

        <div class="feedback">
          <h3>It only takes a minute</h3>
          <p>Every answer is read by our team, and your honest thoughts help shape an even better experience for everyone next time. We'd be so grateful to hear from you.</p>
          <a class="button" href="<%= @feedback_url %>">Share Your Feedback</a>
        </div>

        <% if @contact_email.present? %>
        <p class="closing">
          Got a question, an idea, or something you'd rather tell us in person? We'd love to chat. Drop us a line at <a href="mailto:<%= @contact_email %>" style="color: #d97706; text-decoration: none; font-weight: bold;"><%= @contact_email %></a>.
        </p>
        <% end %>

        <p class="closing">Thank you for your time,</p>
        <p class="signature"><%= @sender_name %></p>
      </div>

      <div class="footer">
        <p>This is an automated email from EventzFlow. Please do not reply to this email.</p>
      </div>
    </div>
  </div>
</body>
</html>
