<%= email_page :teal, icon: 'link', label: 'Access link', title: 'Access your booth bookings',
      tagline: @event.title, footer: 'This is an automated email from EventzFlow. Please do not reply directly to this email.' %>
<p>Hello,</p>
<p>Use the secure one-time link below to access your exhibitor bookings. No password is needed.</p>
<%= render 'emails/buttons', primary: ['Access my bookings', @access_url] %>
<%= render 'emails/callout', text: 'This link expires in 15 minutes and can only be used once. If you did not request this email, you can safely ignore it.' %>
<p style="margin-top:28px">From your booth dashboard you can view existing bookings, upload payment proof, or register another booth.</p>
<%= render 'emails/signoff', name: 'EventzFlow Team' %>
