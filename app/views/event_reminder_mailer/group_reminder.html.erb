<% uniform = @tickets.map(&:ticket_type_id).uniq.one? %>
<% soon = @days_until == 1 %>
<%= email_page :blue, icon: 'bell',
      label: "#{@days_until} day#{'s' if @days_until > 1} to go",
      title: (soon ? 'See you tomorrow' : "#{@days_until} days to go"),
      tagline: @event.title,
      footer: 'This is an automated reminder from EventzFlow. Please do not reply to this email.' %>
<p>Dear <%= @tickets.first.attendee_name %>,</p>
<p>We are looking forward to welcoming your group to <strong><%= @event.title %></strong> <%= soon ? 'tomorrow' : "in #{@days_until} days" %>.</p>
<p>Here is a reminder of your <%= @tickets.size %> tickets. Please make sure each attendee has their QR code ready for a smooth check-in.</p>

<div class="h2">Attendee QR codes</div>
<% @tickets.each_with_index do |ticket, index| %>
  <%= render 'emails/ticket_card', compact: true, title: ticket.attendee_name,
        rows: [
          ['Ticket', "#{index + 1} of #{@tickets.size}"],
          ['Ticket type', (uniform ? nil : ticket.ticket_type.name)],
          ['Ticket ID', ticket.public_id]
        ],
        qr: attachments["qr_code_#{index}.png"].url, qr_size: 104 %>
<% end %>
<p class="qrnote"><strong>Scan at check-in</strong><br>Each attendee should present their own QR code at the registration counter.</p>

<%= render 'emails/details', title: 'Event Details', rows: [
      ['Event', @event.title],
      ['Date', email_date_range(@event)],
      ['Venue', @event.event_locations.first&.name],
      ['Ticket Type', (uniform ? @tickets.first.ticket_type.name : nil)],
      ['Tickets', @tickets.size]
    ] %>

<p style="margin-top:28px">We can't wait to see you there!</p>
