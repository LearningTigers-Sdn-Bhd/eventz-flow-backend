<% soon = @days_until == 1 %>
<%= email_page :blue, icon: 'bell',
      label: "#{@days_until} day#{'s' if @days_until > 1} to go",
      title: (soon ? 'See you tomorrow' : "#{@days_until} days to go"),
      tagline: @event.title,
      footer: 'This is an automated reminder from EventzFlow. Please do not reply to this email.' %>
<p>Dear <%= @ticket.attendee_name %>,</p>
<p>We are looking forward to welcoming you to <strong><%= @event.title %></strong> <%= soon ? 'tomorrow' : "in #{@days_until} days" %>.</p>
<p>Please keep your QR code ready for a smooth check-in. Your ticket details are below.</p>

<%= render 'emails/ticket_card', title: @ticket.ticket_type.name,
      rows: [['Name', @ticket.attendee_name], ['Email', @ticket.attendee_email]],
      qr: attachments['qr_code.png'].url, ticket_id: @ticket.public_id %>
<p class="qrnote"><strong>Scan at check-in</strong><br>Please present this QR code at the registration counter.</p>

<%= render 'emails/details', title: 'Event Details', rows: [
      ['Event', @event.title],
      ['Date', email_date_range(@event)],
      ['Venue', @event.event_locations.first&.name],
      ['Ticket Type', @ticket.ticket_type.name]
    ] %>

<p style="margin-top:28px">We can't wait to see you there!</p>
