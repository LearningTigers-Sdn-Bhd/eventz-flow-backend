<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; background: #f0f4f8; margin: 0; padding: 0; }
    .wrapper { padding: 40px 20px; }
    .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #b45309, #f59e0b); color: white; padding: 36px 30px; text-align: center; }
    .header h1 { margin: 0 0 8px; font-size: 26px; letter-spacing: -0.5px; }
    .header p { margin: 0; font-size: 16px; opacity: 0.9; }
    .content { padding: 32px 30px; }
    .greeting { font-size: 16px; margin-bottom: 14px; }
    .message { font-size: 15px; color: #555; margin-bottom: 22px; line-height: 1.7; }
    .section-title { font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; color: #b45309; margin-bottom: 10px; }
    .info { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin-bottom: 22px; }
    .info table { width: 100%; border-collapse: collapse; }
    .info td { padding: 7px 0; font-size: 14px; vertical-align: top; word-break: break-word; }
    .info td:first-child { font-weight: bold; color: #374151; width: 140px; }
    .info td:last-child { color: #555; }
    @media only screen and (max-width: 480px) {
      .info td { display: block !important; width: 100% !important; }
      .info td:first-child { padding-bottom: 0 !important; }
      .info td:last-child { padding-top: 2px !important; padding-bottom: 14px !important; }
    }
    .notice { background: #fff7ed; border: 1px solid #fdba74; border-radius: 8px; padding: 14px 16px; font-size: 14px; color: #9a3412; margin-bottom: 22px; }
    .closing { font-size: 15px; color: #555; line-height: 1.7; }
    .footer { background: #f8fafc; border-top: 1px solid #e2e8f0; text-align: center; padding: 20px 30px; font-size: 12px; color: #999; }
  </style>
</head>
<body>
  <% ticket_types_uniform = @tickets.map(&:ticket_type_id).uniq.one? %>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <h1>Payment Reminder</h1>
        <p>Complete your payment to secure your spot</p>
      </div>

      <div class="content">
        <p class="greeting">Hi there,</p>

        <p class="message">
          Please complete your payment to confirm your <%= @tickets.size %> ticket registrations for
          <strong><%= @event.title %></strong>.
        </p>

        <div class="section-title">Registration Details</div>
        <div class="info">
          <table>
            <tr>
              <td>Attendee:</td>
              <td><%= @tickets.first.attendee_email %></td>
            </tr>
            <tr>
              <td>Event:</td>
              <td><%= @event.title %></td>
            </tr>
            <% if ticket_types_uniform %>
            <tr>
              <td>Ticket Type:</td>
              <td><%= @tickets.first.ticket_type.name %></td>
            </tr>
            <% end %>
            <tr>
              <td>Tickets Pending:</td>
              <td><%= @tickets.size %></td>
            </tr>
          </table>
        </div>

        <div class="notice">
          Your registrations are still pending payment. Once your payment is confirmed by our team, your e-tickets
          and QR codes will be sent to this email address automatically.
        </div>

        <p class="closing">Once payment is completed, your tickets will be ready for the event.</p>
      </div>

      <div class="footer">
        <p>This is an automated reminder from EventzFlow. Please do not reply to this email.</p>
      </div>
    </div>
  </div>
</body>
</html>
