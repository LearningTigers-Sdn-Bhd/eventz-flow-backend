<% uniform = @tickets.map(&:ticket_type_id).uniq.one? %>
<%= email_page :orange, icon: 'card', label: 'Payment reminder',
      title: 'A gentle reminder about your payment',
      tagline: 'Please complete payment to secure your places',
      footer: 'This is an automated reminder from EventzFlow. Please do not reply to this email.' %>
<p>Dear <%= @tickets.first.attendee_name.presence || 'attendee' %>,</p>
<p>We noticed that payment for your <%= @tickets.size %> ticket registrations to <strong><%= @event.title %></strong> is still outstanding. To keep your places, please complete your payment at your earliest convenience.</p>

<%= render 'emails/details', title: 'Registration Details', rows: [
      ['Attendee', @tickets.first.attendee_email],
      ['Event', @event.title],
      ['Ticket Type', (uniform ? @tickets.first.ticket_type.name : nil)],
      ['Tickets Pending', @tickets.size]
    ] %>
<%= render 'emails/callout', text: 'Once your payment is confirmed by our team, your e-tickets and QR codes will be sent to this email address automatically.' %>

<p style="margin-top:28px">If you have already paid, please disregard this message. Thank you for your understanding.</p>
