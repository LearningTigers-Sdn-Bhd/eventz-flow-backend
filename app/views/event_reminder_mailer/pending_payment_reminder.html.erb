<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #f59e0b; color: white; padding: 20px; text-align: center; }
    .content { padding: 20px; background: #f9fafb; }
    .details { background: white; padding: 15px; border-radius: 8px; margin: 15px 0; }
    .footer { text-align: center; padding: 20px; color: #666; font-size: 12px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Complete your payment for <%= @event.title %></h1>
    </div>

    <div class="content">
      <p>Hello,</p>

      <p>Please complete your payment to confirm your registration for <strong><%= @event.title %></strong>.</p>

      <div class="details">
        <p><strong>Attendee:</strong> <%= @ticket.attendee_email %></p>
        <p><strong>Event:</strong> <%= @event.title %></p>
      </div>

      <p>Once payment is completed, your ticket will be ready for the event.</p>
    </div>

    <div class="footer">
      <p>This email was sent by EventzFlow</p>
    </div>
  </div>
</body>
</html>
