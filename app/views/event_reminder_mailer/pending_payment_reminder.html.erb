<%= email_page :orange, icon: 'card', label: 'Payment reminder',
      title: 'A gentle reminder about your payment',
      tagline: 'Please complete payment to secure your place',
      footer: 'This is an automated reminder from EventzFlow. Please do not reply to this email.' %>
<p>Dear <%= @ticket.attendee_name.presence || 'attendee' %>,</p>
<p>We noticed that payment for your registration to <strong><%= @event.title %></strong> is still outstanding. To keep your place, please complete your payment at your earliest convenience.</p>

<%= render 'emails/details', title: 'Registration Details', rows: [
      ['Attendee', @ticket.attendee_email], ['Event', @event.title]
    ] %>
<%= render 'emails/callout', text: 'Once your payment is confirmed by our team, your e-ticket and QR code will be sent to this email address automatically.' %>

<p style="margin-top:28px">If you have already paid, please disregard this message. Thank you for your understanding.</p>
