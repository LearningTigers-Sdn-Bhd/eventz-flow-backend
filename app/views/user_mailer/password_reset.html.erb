<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #ffffff; color: #1f2937;">
    <!-- Wrapper -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #ffffff;">
      <tr>
        <td align="center" style="padding: 40px 20px;">
          <!-- Main Content Container -->
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 8px;">

            <!-- Logo Header -->
            <tr>
              <td align="center" style="padding: 0 0 30px 0;">
                <h1 style="margin: 0; font-size: 32px; font-weight: 700; letter-spacing: -0.5px;">
                  <span style="color: #34d399;">Event</span><span style="color: #3b82f6;">z</span><span style="color: #34d399;">Flow</span>
                </h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px 30px; background-color: #ffffff; border-radius: 8px;">
                <!-- Greeting -->
                <h2 style="margin: 0 0 20px 0; font-size: 24px; font-weight: 600; color: #111827; line-height: 1.3;">
                  Hi <%= @user.full_name.presence || @user.email %>,
                </h2>

                <p style="margin: 0 0 20px 0; font-size: 16px; color: #4b5563; line-height: 1.6;">
                  We received a request to reset your password. Click the button below to choose a new password.
                </p>

                <!-- Reset Button -->
                <% reset_url = @reset_password_url %>
                <div style="margin: 24px 0; text-align: center;">
                  <a href="<%= reset_url %>" style="
                    display: inline-block;
                    background-color: #059669;
                    color: #ffffff;
                    padding: 12px 20px;
                    border-radius: 8px;
                    text-decoration: none;
                    font-weight: 600;
                  ">
                    Reset your password
                  </a>
                </div>

                <p style="margin: 0 0 8px 0; color: #6b7280; line-height: 1.5; text-align: center;">
                  If the button doesn’t work, copy and paste this URL into your browser:
                </p>
                <p style="margin: 0 0 16px 0; word-break: break-all; text-align: center;">
                  <a href="<%= reset_url %>" style="color: #059669; text-decoration: underline;"><%= reset_url %></a>
                </p>

                <!-- Expiration Notice -->
                <p style="margin: 0 0 30px 0; font-size: 14px; color: #6b7280; line-height: 1.5; text-align: center;">
                  For security, this link will expire in <strong style="color: #059669;"><%= @expires_in %> minutes</strong>
                </p>

                <!-- Divider -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 30px 0;">
                  <tr>
                    <td style="border-top: 1px solid #e5e7eb;"></td>
                  </tr>
                </table>

                <!-- Footer Info -->
                <p style="margin: 0 0 15px 0; font-size: 14px; color: #6b7280; line-height: 1.6;">
                  If you didn’t request a password reset, you can safely ignore this email.
                </p>

                <p style="margin: 0; font-size: 14px; color: #6b7280; line-height: 1.6;">
                  Thank you for using <strong style="color: #34d399;">EventzFlow</strong>!
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="padding: 30px 20px 20px 20px;">
                <p style="margin: 0; font-size: 12px; color: #9ca3af; line-height: 1.5;">
                  © <%= Date.current.year %> EventzFlow. All rights reserved.<br>
                  This is an automated message, please do not reply.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
  </html>
