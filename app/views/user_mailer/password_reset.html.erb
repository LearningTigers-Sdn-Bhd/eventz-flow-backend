<%= email_page :slate, icon: 'lock', label: 'Password reset', title: 'Reset your password',
      footer: "© #{Date.current.year} EventzFlow. All rights reserved. This is an automated message, please do not reply." %>
<p>Hi <%= @user.full_name.presence || @user.email %>,</p>
<p>We received a request to reset your password. Please use the button below to choose a new one.</p>
<%= render 'emails/buttons', primary: ['Reset your password', @reset_password_url] %>
<p class="qrnote">If the button doesn’t work, copy and paste this link into your browser:<br><a class="link" href="<%= @reset_password_url %>" style="word-break:break-all"><%= @reset_password_url %></a></p>
<%= render 'emails/callout', text: "For security, this link will expire in #{@expires_in} minutes. If you didn’t request a password reset, you can safely ignore this email." %>
<p style="margin-top:28px">Thank you for using EventzFlow!</p>
