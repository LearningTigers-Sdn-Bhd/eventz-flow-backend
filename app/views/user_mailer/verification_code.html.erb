<div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background-color: #f4f4f4; padding: 30px; border-radius: 10px;">
    <h1 style="color: #2c3e50; text-align: center; margin-bottom: 30px;">Email Verification</h1>

    <p style="font-size: 16px;">Hello <%= @user.full_name %>,</p>

    <p style="font-size: 16px;">
      Thank you for registering with EventzFlow! To complete your registration, please verify your email address by entering the following 6-digit code:
    </p>

    <div style="background-color: #fff; border: 2px solid #3498db; border-radius: 8px; padding: 20px; text-align: center; margin: 30px 0;">
      <h2 style="color: #3498db; font-size: 36px; letter-spacing: 10px; margin: 0; font-family: 'Courier New', monospace;"><%= @code %></h2>
    </div>

    <p style="font-size: 14px; color: #7f8c8d; margin-top: 20px;">
      This code will expire in <%= @expires_in %> minutes.
    </p>

    <p style="font-size: 14px; color: #e74c3c; margin-top: 20px;">
      If you didn't create an account with EventzFlow, please ignore this email.
    </p>

    <hr style="border: none; border-top: 1px solid #ddd; margin: 30px 0;">

    <p style="font-size: 12px; color: #95a5a6; text-align: center; margin: 0;">
      EventzFlow Team
    </p>
  </div>
</div>
