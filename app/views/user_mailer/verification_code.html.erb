<%= email_page :slate, icon: 'shield', label: 'Verify email', title: "Welcome, #{@user.full_name}",
      footer: "© #{Date.current.year} EventzFlow. All rights reserved. This is an automated message, please do not reply." %>
<p>Please use the verification code below to complete your email verification.</p>
<table role="presentation" width="100%" class="ticket"><tr><td style="text-align:center">
  <div style="text-align:center;padding-left:8px;font-size:36px;letter-spacing:8px;font-family:ui-monospace,Menlo,'Courier New',monospace;color:#1a1a1a"><%= @code %></div>
</td></tr></table>
<%= render 'emails/callout', text: "This code will expire in #{@expires_in} minutes. If you didn’t request this code, you can safely ignore this email." %>
<p style="margin-top:28px">Thank you for using EventzFlow!</p>
