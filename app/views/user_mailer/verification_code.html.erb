<div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <!-- preheader (hidden in most clients, shown in inbox preview) -->
  <div style="display:none;visibility:hidden;mso-hide:all;font-size:1px;color:#fff;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">
    Your code expires in <%= @expires_in %> minutes.
  </div>

  <h1 style="color: #2c3e50; text-align: left; margin-bottom: 20px;">Email verification</h1>

  <p style="font-size: 16px; margin: 0 0 12px;">Hello <%= (@user.respond_to?(:full_name) && @user.full_name.present?) ? @user.full_name : 'there' %>,</p>

  <p style="font-size: 16px; margin: 0 0 16px;">Use this code to verify your email:</p>

  <div style="background-color: #fff; border: 1px solid #d0e6f8; border-radius: 6px; padding: 16px; text-align: center; margin: 16px 0;">
    <div style="color: #1a73e8; font-size: 32px; letter-spacing: 8px; font-family: 'Courier New', monospace;">
      <%= @code %>
    </div>
  </div>

  <p style="font-size: 14px; color: #5f6c72; margin: 0 0 16px;">This code expires in <%= @expires_in %> minutes.</p>

  <p style="font-size: 14px; color: #5f6c72; margin: 0 0 16px;">If you didn’t request this, you can safely ignore this email.</p>

  <hr style="border: none; border-top: 1px solid #eee; margin: 24px 0;">

  <p style="font-size: 12px; color: #8e9aa0; margin: 0 0 4px;">EventzFlow</p>
  <p style="font-size: 12px; color: #8e9aa0; margin: 0;">
    <a href="https://eventzflow.com" style="color:#6b7280; text-decoration: underline;">https://eventzflow.com</a>
  </p>
</div>
