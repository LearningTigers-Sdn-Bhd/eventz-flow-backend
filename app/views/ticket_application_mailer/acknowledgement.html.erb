<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; background: #f0f4f8; margin: 0; padding: 0; }
    .wrapper { padding: 40px 20px; }
    .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #1e40af, #2563eb); color: white; padding: 40px 30px; text-align: center; }
    .header h1 { margin: 0 0 8px; font-size: 28px; letter-spacing: -0.5px; }
    .header p { margin: 0; font-size: 16px; opacity: 0.9; }
    .content { padding: 32px 30px; }
    .greeting { font-size: 16px; margin-bottom: 16px; }
    .message { font-size: 15px; color: #555; margin-bottom: 20px; line-height: 1.7; }
    .section-title { font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; color: #2563eb; margin-bottom: 12px; }
    .info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin-bottom: 22px; }
    .info-box table { width: 100%; border-collapse: collapse; }
    .info-box td { padding: 8px 0; font-size: 14px; vertical-align: top; }
    .info-box td:first-child { font-weight: bold; color: #374151; width: 170px; }
    .info-box td:last-child { color: #555; }
    .next-steps { margin: 0 0 22px; padding-left: 18px; color: #555; }
    .next-steps li { margin-bottom: 8px; }
    .closing { font-size: 15px; color: #555; line-height: 1.7; margin-bottom: 8px; }
    .signature { font-size: 15px; color: #333; font-weight: bold; }
    .footer { background: #f8fafc; border-top: 1px solid #e2e8f0; text-align: center; padding: 20px 30px; font-size: 12px; color: #999; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <h1>Application Received</h1>
        <p>Thank you for your interest in joining us</p>
      </div>

      <div class="content">
        <p class="greeting">Dear <strong><%= @ticket.attendee_name %></strong>,</p>

        <p class="message">
          Thank you for applying to <strong><%= @event.title %></strong>. We have successfully received your application for <strong><%= @ticket_type.name %></strong>.
        </p>

        <div class="section-title">Application Summary</div>
        <div class="info-box">
          <table>
            <tr>
              <td>Event</td>
              <td><%= @event.title %></td>
            </tr>
            <tr>
              <td>Application Category</td>
              <td><%= @ticket_type.name %></td>
            </tr>
            <tr>
              <td>Review Target</td>
              <td>Within <%= @setting&.review_sla_hours || 48 %> hours</td>
            </tr>
            <% if @setting&.notify_by_date.present? %>
              <tr>
                <td>Decision Notice By</td>
                <td><%= @setting.notify_by_date.in_time_zone.strftime('%B %d, %Y') %></td>
              </tr>
            <% end %>
          </table>
        </div>

        <div class="section-title">What Happens Next</div>
        <ul class="next-steps">
          <li>Our committee will review your application details.</li>
          <li>If approved, we will email you an RSVP confirmation link.</li>
          <li>No action is needed from you for now.</li>
        </ul>

        <p class="closing">
          We appreciate your interest and look forward to welcoming you.
          <% if @contact_email.present? %>
            If you need assistance, feel free to contact us at
            <a href="mailto:<%= @contact_email %>" style="color: #2563eb; text-decoration: none; font-weight: bold;"><%= @contact_email %></a>.
          <% end %>
        </p>

        <p class="closing">Warm regards,</p>
        <p class="signature"><%= @event.title %> Team</p>
      </div>

      <div class="footer">
        <p>This is an automated update from EventzFlow. Please do not reply directly to this email.</p>
      </div>
    </div>
  </div>
</body>
</html>
