<%= email_page :sky, icon: 'file', label: 'Application received', title: 'We have received your application',
      tagline: 'Thank you for your interest in joining us', footer: 'This is an automated update from EventzFlow. Please do not reply directly to this email.' %>
<p>Dear <%= @ticket.attendee_name %>,</p>
<p>Thank you for applying to <strong><%= @event.title %></strong>. We are pleased to confirm that your application for <strong><%= @ticket_type.name %></strong> has been received and is now with our review committee.</p>

<%= render 'emails/details', title: 'Application Summary', rows: [
      ['Event', @event.title],
      ['Category', @ticket_type.name],
      ['Review Time', "Within #{@setting&.review_sla_hours || 48} hours"],
      ['Decision By', @setting&.notify_by_date&.in_time_zone&.strftime('%B %d, %Y')]
    ] %>
<%= render 'emails/callout', title: 'What happens next', items: [
      'Our committee will review your application details.',
      'If approved, we will email you a link to confirm your RSVP.',
      'No action is needed from you for now.'
    ] %>

<p style="margin-top:28px">We appreciate your interest and hope to welcome you.
  <% if @contact_email.present? %>For any assistance, please contact us at <%= mail_to @contact_email, nil, class: 'link' %>.<% end %></p>
<%= render 'emails/signoff', name: "#{@event.title} Team" %>
