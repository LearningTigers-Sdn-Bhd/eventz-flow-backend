<%= email_page :green, icon: 'check', label: 'Application approved', title: 'Your application has been approved',
      tagline: 'We would be delighted to welcome you', footer: 'This is an automated update from EventzFlow. Please do not reply directly to this email.' %>
<p>Dear <%= @ticket.attendee_name %>,</p>
<p>We are pleased to inform you that your application for <strong><%= @event.title %></strong> has been approved.</p>
<p>To secure your place, please confirm your attendance using the button below.</p>
<%= render 'emails/buttons', primary: ['Confirm RSVP', @rsvp_url] %>
<%= render 'emails/callout', title: 'RSVP link status', text: (@ticket_application.rsvp_expires_at.present? ? "This RSVP link expires on #{@ticket_application.rsvp_expires_at.in_time_zone.strftime('%B %d, %Y %I:%M %p')}." : 'This RSVP link does not expire.') %>

<p style="margin-top:28px">Your QR ticket will be issued immediately after you confirm your RSVP.
  <% if @contact_email.present? %>If you need any help, please contact us at <%= mail_to @contact_email, nil, class: 'link' %>.<% end %></p>
<p>We look forward to hosting you.</p>
<%= render 'emails/signoff', name: "#{@event.title} Team" %>
