<%= email_page :slate, icon: 'info', label: 'Application update', title: 'An update on your application',
      tagline: 'Thank you for your interest and your time', footer: 'This is an automated update from EventzFlow. Please do not reply directly to this email.' %>
<p>Dear <%= @ticket.attendee_name %>,</p>
<p>Thank you for applying to <strong><%= @event.title %></strong>, and for the time you took to do so.</p>
<p>After careful consideration, we are unable to offer you a place this time.</p>
<%= render 'emails/callout', title: 'Reason', text: @rejection_reason %>

<p style="margin-top:28px">We truly appreciate your interest in <strong><%= @event.title %></strong> and your understanding.
  <% if @contact_email.present? %>For any assistance, please contact us at <%= mail_to @contact_email, nil, class: 'link' %>.<% end %></p>
<%= render 'emails/signoff', closing: 'With kind regards,', name: "#{@event.title} Team" %>
