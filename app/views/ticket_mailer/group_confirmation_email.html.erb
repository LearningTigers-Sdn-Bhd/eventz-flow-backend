<% uniform = @tickets.map(&:ticket_type_id).uniq.one? %>
<% representative = @tickets.first %>
<% payment = representative.ticket_payment %>
<% unit_price = (payment&.amount || representative.ticket_type.current_price).to_f %>
<% show_receipt = representative.paid? && unit_price.positive? %>
<% currency = payment&.currency.presence || 'MYR' %>
<%= email_page :green,
      icon: (@tickets.one? ? 'check' : 'users'),
      label: (@tickets.one? ? 'Ticket confirmed' : 'Tickets confirmed'),
      title: (@tickets.one? ? 'Your registration is confirmed' : 'Your group registration is confirmed'),
      tagline: "We are delighted to welcome #{@tickets.one? ? 'you' : 'your group'} to #{@event.title}",
      footer: 'This is an automated confirmation email from EventzFlow. Please do not reply to this email.' %>
<p>Dear <%= representative.attendee_name %>,</p>
<% if @tickets.one? %>
  <p>Thank you for registering for <strong><%= @event.title %></strong>. It is our pleasure to confirm your place, and we look forward to welcoming you in person.</p>
<% else %>
  <p>Thank you for registering your group for <strong><%= @event.title %></strong>. It is our pleasure to confirm all <%= @tickets.size %> places, and we look forward to welcoming everyone.</p>
  <p>Each attendee has their own QR code below. Please ask them to present it at the registration counter on arrival.</p>
<% end %>

<div class="h2"><%= @tickets.one? ? 'Your entry QR code' : 'Attendee QR codes' %></div>
<% @tickets.each_with_index do |ticket, index| %>
  <%= render 'emails/ticket_card', compact: true, title: ticket.attendee_name,
        rows: [
          ['Ticket', (@tickets.one? ? nil : "#{index + 1} of #{@tickets.size}")],
          ['Ticket type', (uniform ? nil : ticket.ticket_type.name)],
          ['Ticket ID', ticket.public_id]
        ],
        qr: attachments["qr_code_#{index}.png"].url, qr_size: 104 %>
<% end %>
<p class="qrnote"><strong>Scan at check-in</strong><br>Each attendee should present their own QR code at the registration counter.</p>

<%= render 'emails/details', title: 'Event Details', rows: [
      ['Event', @event.title],
      ['Date', email_date_range(@event)],
      ['Venue', @event.event_locations.first&.name],
      ['Ticket Type', (uniform ? representative.ticket_type.name : nil)],
      ['Tickets', (@tickets.one? ? nil : @tickets.size)]
    ] %>

<% if show_receipt %>
  <%= render 'emails/details', title: 'Payment Receipt', rows: [
        ['Receipt No', representative.public_id],
        ['Payment Status', 'Paid'],
        ['Payment Date', payment&.paid_at&.in_time_zone&.strftime('%B %d, %Y %I:%M %p %Z')],
        ['Amount Paid', (@tickets.one? ? email_money(currency, unit_price) : "#{email_money(currency, unit_price)} × #{@tickets.size} = #{email_money(currency, unit_price * @tickets.size)}")],
        ['Transaction ID', payment&.gateway_payment_id.presence],
        ['Order ID', payment&.gateway_response&.dig('order_id').presence]
      ] %>
<% end %>

<p style="margin-top:28px">
  <% if @contact_email.present? %>
    Should you need any assistance, please contact us at <%= mail_to @contact_email, nil, class: 'link' %>. We wish you a wonderful and memorable experience.
  <% else %>
    We wish you a wonderful and memorable experience at the event.
  <% end %>
</p>
<%= render 'emails/signoff', name: @sender_name %>
