<% representative = @tickets.first %>
<% uniform = @tickets.map(&:ticket_type_id).uniq.one? %>
<% many = !@tickets.one? %>
<%= email_page :amber, icon: 'hourglass', label: 'Payment pending',
      title: 'We have received your registration',
      tagline: "Your e-ticket#{'s' if many} will follow once payment is verified",
      footer: 'This is an automated email from EventzFlow. Please do not reply directly to this email.' %>
<p>Dear <%= representative.attendee_name %>,</p>
<p>Thank you for registering <%= many ? 'your group' : '' %> for <strong><%= @event.title %></strong>. If you have already made payment, our team is verifying it and will confirm shortly. If not, please complete your payment as instructed to secure your <%= many ? "#{@tickets.size} places" : 'place' %>.</p>

<%= render 'emails/details', title: 'Registration Details', rows: [
      ['Event', @event.title],
      ['Ticket Type', (uniform ? representative.ticket_type.name : nil)],
      ['Tickets', (many ? @tickets.size : nil)]
    ] %>
<%= render 'emails/callout', text: "Once your payment is confirmed, your e-ticket#{'s' if many} and QR code#{'s' if many} will be sent to this email address automatically." %>

<p style="margin-top:28px">
  <% if @contact_email.present? %>
    If you have any questions in the meantime, please contact us at <%= mail_to @contact_email, nil, class: 'link' %>. We look forward to seeing you there!
  <% else %>
    We look forward to seeing you there!
  <% end %>
</p>
<%= render 'emails/signoff', name: @sender_name %>
