<%= email_page :teal, icon: 'gift', label: 'Exhibitor vouchers',
      title: 'A little something for you',
      tagline: "Exclusive exhibitor offers at #{@event.title}" %>
<p>Dear <%= @ticket.attendee_name %>,</p>
<p>Thank you for joining us at <strong><%= @event.title %></strong>. It is a pleasure to have you with us.</p>
<p>To make your visit even more rewarding, our exhibitors have prepared <strong><%= pluralize(@voucher_count, 'exclusive voucher') %></strong> for attendees. Have a look below and enjoy them during the event.</p>

<%= render 'emails/details', title: 'Featured Vouchers', rows: @vouchers.map { |voucher| [voucher.vendor&.full_name, voucher.title] } %>
<%= render 'emails/buttons', primary: ['View all vouchers', @showcase_url] %>
<%= render 'emails/callout', title: 'How to redeem', text: raw("Visit the booth and their team will scan the voucher's QR code, followed by your registration QR code. No extra code is needed.") %>

<p style="margin-top:28px">We hope these offers bring a little extra joy to your visit. Enjoy the event!</p>
<%= render 'emails/signoff', name: @sender_name %>
