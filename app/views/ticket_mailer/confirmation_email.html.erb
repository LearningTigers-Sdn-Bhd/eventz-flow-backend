<% upgrade = @borneo_upgrade_ticket %>
<%= email_page :green,
      icon: (upgrade ? 'arrow-up' : (@show_payment_receipt ? 'check' : 'ticket')),
      label: (upgrade ? 'Ticket upgraded' : 'Ticket confirmed'),
      title: (upgrade ? 'Your ticket has been upgraded' : 'Your registration is confirmed'),
      tagline: (upgrade ? 'Your original QR code remains valid' : "We are delighted to welcome you to #{@event.title}"),
      footer: 'This is an automated confirmation email from EventzFlow. Please do not reply to this email.' %>
<p>Dear <%= @ticket.attendee_name %>,</p>
<% if upgrade %>
  <p>Thank you for registering for <strong><%= @event.title %></strong>. Your existing ticket has been upgraded to <strong><%= @ticket_type.name %></strong>, giving you both exhibitor and conference access.</p>
  <p>Your same QR code remains valid. Your updated details are below &mdash; please present the QR code at the registration counter on arrival.</p>
<% else %>
  <p>Thank you for registering for <strong><%= @event.title %></strong>. It is our pleasure to confirm your place, and we look forward to welcoming you in person.</p>
  <p>Your ticket and entry QR code are below. Please present the QR code at the registration counter when you arrive.</p>
<% end %>

<%= render 'emails/ticket_card', title: @ticket_type.name,
      rows: [['Name', @ticket.attendee_name], ['Email', @ticket.attendee_email]],
      qr: attachments['qr_code.png'].url, ticket_id: @ticket.public_id %>
<p class="qrnote"><strong>Scan at check-in</strong><br>Please present this QR code at the registration counter.</p>

<%= render 'emails/details', title: 'Event Details', rows: [
      ['Event', @event.title],
      ['Date', email_date_range(@event)],
      ['Venue', @event.event_locations.first&.name],
      ['Ticket Type', @ticket_type.name]
    ] %>

<% if @show_payment_receipt %>
  <%= render 'emails/details', title: 'Payment Receipt', rows: [
        ['Receipt No', @ticket.public_id],
        ['Payment Status', 'Paid'],
        ['Payment Date', @ticket_payment&.paid_at&.in_time_zone&.strftime('%B %d, %Y %I:%M %p %Z')],
        ['Amount Paid', email_money(@ticket_payment&.currency, @ticket_payment&.amount || @ticket_type.current_price)],
        ['Transaction ID', @ticket_payment&.gateway_payment_id.presence],
        ['Order ID', @ticket_payment&.gateway_response&.dig('order_id').presence]
      ] %>
<% end %>

<p style="margin-top:28px">
  <% if @contact_email.present? %>
    Should you need any assistance, please contact us at <%= mail_to @contact_email, nil, class: 'link' %>. We wish you a wonderful and memorable experience.
  <% else %>
    We wish you a wonderful and memorable experience at the event.
  <% end %>
</p>
<%= render 'emails/signoff', name: @sender_name %>
