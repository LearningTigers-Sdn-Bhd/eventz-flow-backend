<%= email_page :amber, icon: 'hourglass', label: 'Payment pending',
      title: 'We have received your registration',
      tagline: 'Your e-ticket will follow once payment is verified',
      footer: 'This is an automated email from EventzFlow. Please do not reply directly to this email.' %>
<p>Dear <%= @ticket.attendee_name %>,</p>
<p>Thank you for registering for <strong><%= @event.title %></strong>. If you have already made payment, our team is verifying it and will confirm shortly. If not, please complete your payment as instructed to secure your place.</p>

<%= render 'emails/details', title: 'Registration Details', rows: [
      ['Event', @event.title], ['Ticket Type', @ticket_type.name], ['Ticket ID', @ticket.public_id]
    ] %>
<%= render 'emails/callout', text: 'Once your payment is confirmed, your e-ticket and QR code will be sent to this email address automatically.' %>

<p style="margin-top:28px">
  <% if @contact_email.present? %>
    If you have any questions in the meantime, please contact us at <%= mail_to @contact_email, nil, class: 'link' %>. We look forward to seeing you there!
  <% else %>
    We look forward to seeing you there!
  <% end %>
</p>
<%= render 'emails/signoff', name: @sender_name %>
