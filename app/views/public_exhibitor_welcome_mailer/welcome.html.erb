<%= email_page :teal, icon: 'key', label: 'Welcome', title: 'Welcome to EventzFlow',
      tagline: 'Your exhibitor account is ready', footer: 'This is an automated email from EventzFlow. Please do not reply directly to this email.' %>
<p>Dear <%= @name.presence || 'there' %>,</p>
<p>Your exhibitor account is ready. Sign in to manage your booths, update exhibitor details where available, add team members, and order items and services.</p>
<%= render 'emails/details', title: 'Account Details', rows: [['Email', @email], ['Temporary password', @temporary_password]] %>
<%= render 'emails/buttons', primary: ['Log in to EventzFlow', @login_url] %>
<%= render 'emails/callout', text: 'For your security, please update your password promptly after signing in.' %>
<p style="margin-top:28px">We look forward to helping you prepare for the event.</p>
<%= render 'emails/signoff', name: 'EventzFlow Team' %>
