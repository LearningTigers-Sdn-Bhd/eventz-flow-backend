<%= email_page :green, icon: 'check', label: 'Payment confirmed', title: 'Your booth is confirmed',
      tagline: 'Payment received, thank you', footer: 'This is an automated email from EventzFlow. Please do not reply directly to this email.' %>
<p>Dear <%= @exhibitor_kit.pic_full_name %>,</p>
<p>Great news! Your exhibitor payment for <strong><%= @event.title %></strong> has been confirmed, and your booth reservation is now secured. We look forward to welcoming you.</p>

<%= render 'emails/details', title: 'Payment Details', rows: [
      ['Booking Reference', @booking_reference],
      ['Event', @event.title],
      ['Company', @exhibitor_kit.company_name],
      ['Booth', @booth_label],
      ['Amount Paid', "RM #{@exhibitor_kit.amount_paid}"],
      ['Payment Status', 'Paid']
    ] %>
<%= render 'emails/details', title: 'Payment Receipt', rows: [
      ['Receipt No', "EXH-#{@booking_reference}"],
      ['Payment Status', 'Paid'],
      ['Payment Date', (@exhibitor_payment&.paid_at.present? ? @exhibitor_payment.paid_at.in_time_zone.strftime('%B %d, %Y %I:%M %p %Z') : 'Not available')],
      ['Amount Paid', email_money(@exhibitor_payment&.gateway_response&.dig('currency'), @exhibitor_payment&.amount || @exhibitor_kit.amount_paid)],
      ['Transaction ID', @exhibitor_payment&.gateway_payment_id.presence],
      ['Order ID', @exhibitor_payment&.gateway_response&.dig('order_id').presence]
    ] %>

<%= render 'emails/callout', title: 'What to do next', text: 'To prepare your exhibitor passes:', items: [
      raw("Log in to your exhibitor account at <a class=\"link\" href=\"https://eventzflow.com\">eventzflow.com</a>."),
      'Add your team members under your exhibitor account.',
      'Each registered team member will receive an exhibitor pass with a QR code.'
    ] %>

<% if @manage_url.present? %>
  <%= render 'emails/buttons', primary: ['Securely manage this booking', @manage_url] %>
  <p class="qrnote">Email verification is required.</p>
<% end %>
<% if @contact_email.present? %>
  <p style="margin-top:28px">If you need any support, please contact us at <%= mail_to @contact_email, nil, class: 'link' %>.</p>
<% end %>
<%= render 'emails/signoff', name: @sender_name %>
