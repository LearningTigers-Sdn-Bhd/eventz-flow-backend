<%= email_page :amber, icon: 'store', label: 'Registration received', title: 'We have received your booth registration',
      tagline: 'Your submission is now in our system', footer: 'This is an automated email from EventzFlow. Please do not reply directly to this email.' %>
<p>Dear <%= @exhibitor_kit.pic_full_name %>,</p>
<p>Thank you for registering as an exhibitor for <strong><%= @event.title %></strong>. We have received your submission, and the details are recorded below.</p>

<%= render 'emails/details', title: 'Registration Details', rows: [
      ['Booking Reference', @booking_reference],
      ['Event', @event.title],
      ['Company', @exhibitor_kit.company_name],
      ['Booth', @booth_label],
      ['Price', (@exhibitor_kit.price_snapshot.to_f > 0 ? "RM #{@exhibitor_kit.price_snapshot}" : nil)],
      ['Amount Paid', (@exhibitor_kit.amount_paid.to_f > 0 ? "RM #{@exhibitor_kit.amount_paid}" : nil)],
      ['Payment Status', @exhibitor_kit.payment_status.humanize]
    ] %>
<%= render 'emails/callout', text: (@exhibitor_kit.price_snapshot.to_f > 0 ? 'If your payment is still pending, please complete it to secure and confirm your booth reservation.' : 'Your selected booth requires price negotiation. Please await further instructions regarding pricing.') %>

<% if @manage_url.present? %>
  <%= render 'emails/buttons', primary: ['Securely manage this booking', @manage_url] %>
  <p class="qrnote">Email verification is required.</p>
<% end %>
<% if @contact_email.present? %>
  <p style="margin-top:28px">If you need any support, please contact us at <%= mail_to @contact_email, nil, class: 'link' %>. We look forward to welcoming you as an exhibitor.</p>
<% end %>
<%= render 'emails/signoff', name: @sender_name %>
