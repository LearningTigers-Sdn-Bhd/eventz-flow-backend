<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; background: #f0f4f8; margin: 0; padding: 0; }
    .wrapper { padding: 40px 20px; }
    .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #1e40af, #2563eb); color: white; padding: 36px 30px; text-align: center; }
    .header h1 { margin: 0 0 8px; font-size: 28px; letter-spacing: -0.5px; }
    .header p { margin: 0; font-size: 16px; opacity: 0.9; }
    .content { padding: 32px 30px; }
    .greeting { font-size: 16px; margin-bottom: 14px; }
    .message { font-size: 15px; color: #555; margin-bottom: 22px; }
    .section-title { font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; color: #2563eb; margin-bottom: 10px; }
    .info { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin-bottom: 22px; }
    .info table { width: 100%; border-collapse: collapse; }
    .info td { padding: 7px 0; font-size: 14px; vertical-align: top; word-break: break-word; }
    .info td:first-child { font-weight: bold; color: #374151; width: 140px; }
    .info td:last-child { color: #555; }
    @media only screen and (max-width: 480px) {
      .info td { display: block !important; width: 100% !important; }
      .info td:first-child { padding-bottom: 0 !important; }
      .info td:last-child { padding-top: 2px !important; padding-bottom: 14px !important; }
    }
    .notice { background: #fff7ed; border: 1px solid #fdba74; border-radius: 8px; padding: 14px 16px; font-size: 14px; color: #9a3412; margin-bottom: 22px; }
    .closing { font-size: 15px; color: #555; line-height: 1.7; }
    .signature { font-size: 15px; color: #333; font-weight: bold; margin-top: 8px; }
    .footer { background: #f8fafc; border-top: 1px solid #e2e8f0; text-align: center; padding: 20px 30px; font-size: 12px; color: #999; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <h1>Registration Received</h1>
        <p>Your booth submission is now in our system</p>
      </div>

      <div class="content">
        <p class="greeting">Hi <strong><%= @exhibitor_kit.pic_full_name %></strong>,</p>

        <p class="message">
          Thank you for registering as an exhibitor for <strong><%= @event.title %></strong>.
          We have received your submission and recorded the details below.
        </p>

        <div class="section-title">Registration Details</div>
        <div class="info">
          <table>
            <tr>
              <td>Booking Reference:</td>
              <td><%= @booking_reference %></td>
            </tr>
            <tr>
              <td>Event:</td>
              <td><%= @event.title %></td>
            </tr>
            <tr>
              <td>Company:</td>
              <td><%= @exhibitor_kit.company_name %></td>
            </tr>
            <tr>
              <td>Booth:</td>
              <td><%= @booth_label %></td>
            </tr>
            <% if @exhibitor_kit.amount_paid.to_f > 0 %>
              <tr>
                <td>Amount:</td>
                <td>RM <%= @exhibitor_kit.amount_paid %></td>
              </tr>
            <% end %>
            <tr>
              <td>Payment Status:</td>
              <td><%= @exhibitor_kit.payment_status.humanize %></td>
            </tr>
          </table>
        </div>

        <% if @exhibitor_kit.amount_paid.to_f > 0 %>
          <div class="notice">
            If your payment is still pending, please complete payment to secure and confirm your booth reservation.
          </div>
        <% else %>
          <div class="notice">
            Your selected booth requires price negotiation. Please await further instructions regarding pricing.
          </div>
        <% end %>

        <% if @manage_url.present? %>
          <p class="closing"><a href="<%= @manage_url %>" style="color: #2563eb; font-weight: bold;">Securely manage this booking</a>. Email verification is required.</p>
        <% end %>

        <% if @contact_email.present? %>
          <p class="closing">If you need support, contact us at <a href="mailto:<%= @contact_email %>" style="color: #2563eb; text-decoration: none; font-weight: bold;"><%= @contact_email %></a>.</p>
        <% end %>
        <p class="closing">Warm regards,</p>
        <p class="signature"><%= @sender_name %></p>
      </div>

      <div class="footer">
        <p>This is an automated email from EventzFlow. Please do not reply directly to this email.</p>
      </div>
    </div>
  </div>
</body>
</html>
