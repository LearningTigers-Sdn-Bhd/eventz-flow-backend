<%= email_page :red, icon: 'cal-x', label: 'Cancelled', title: 'A booking has been cancelled', tagline: @event_title,
      footer: "&copy; #{Time.now.year} EventzFlow. All rights reserved.".html_safe %>
<p>Dear <%= @host.full_name %>,</p>
<p><strong><%= @booking['name'] %></strong> has cancelled their session with you.</p>
<%= render 'emails/details', title: 'Cancelled Booking', rows: [['Date', @booking_date], ['Time', @booking_time], ['Name', @booking['name']], ['Email', @booking['email']]] %>
<%= render 'emails/buttons', primary: ['View on EventzFlow', @dashboard_url] %>
<%= render 'emails/signoff', closing: 'Best regards,', name: 'The Organizing Team' %>
