<%= email_page :green, icon: 'cal-check', label: 'Booking approved', title: 'Your meeting is confirmed', tagline: @event_title,
      footer: "&copy; #{Time.now.year} EventzFlow. All rights reserved.".html_safe %>
<p>Dear <%= @booking['name'] || 'Valued Customer' %>,</p>
<p>Good news, the host has approved your request. Your business matching meeting at <strong><%= @event_title %></strong> is now confirmed.</p>
<%= render 'emails/details', title: 'Booking Details', rows: [['Date', @booking_date], ['Time', @booking_time], ['Location', @booking['location']]] %>
<%= render 'emails/booking_actions' %>
<p style="margin-top:28px">We look forward to seeing you there!</p>
<%= render 'emails/signoff', closing: 'Best regards,', name: 'The Organizing Team' %>
