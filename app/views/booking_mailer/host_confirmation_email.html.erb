<% pending = @booking['status'] == 'Pending' %>
<%= email_page :violet, icon: 'mail', label: (pending ? 'Booking request' : 'New booking'),
      title: (pending ? 'You have a new booking request' : 'You have a new booking'), tagline: @event_title,
      footer: "&copy; #{Time.now.year} EventzFlow. All rights reserved.".html_safe %>
<p>Dear <%= @host.full_name %>,</p>
<% if pending %>
  <p><strong><%= @booking['name'] %></strong> has requested a business matching session with you. It is <strong>pending your approval</strong>. Please open EventzFlow to approve the request and confirm the slot.</p>
<% else %>
  <p><strong><%= @booking['name'] %></strong> has booked a business matching session with you.</p>
<% end %>
<%= render 'emails/details', title: 'Booking Details', rows: [
      ['Date', @booking_date], ['Time', @booking_time], ['Name', @booking['name']],
      ['Email', @booking['email']], ['Phone', @booking['phone']], ['Location', @booking['location']]
    ] %>
<%= render 'emails/buttons', primary: [(pending ? 'Review and approve' : 'View on EventzFlow'), @dashboard_url] %>
<%= render 'emails/signoff', closing: 'Best regards,', name: 'The Organizing Team' %>
