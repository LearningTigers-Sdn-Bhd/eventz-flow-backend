body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  color: #333;
}
.container {
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  padding: 20px;
  border: 1px solid #ddd;
  border-radius: 5px;
  background-color: #f9f9f9;
}
.header {
  background-color: #f2f2f2;
  padding: 10px 20px;
  text-align: center;
  border-bottom: 1px solid #ddd;
}
.content {
  padding: 20px;
}
.details {
  background-color: #fff;
  border: 1px solid #eee;
  padding: 15px;
  border-radius: 5px;
}
.details p {
  margin: 5px 0;
}
.footer {
  text-align: center;
  margin-top: 20px;
  font-size: 0.9em;
  color: #777;
}
.button {
  display: inline-block;
  background-color: #007bff;
  color: #ffffff;
  padding: 10px 20px;
  text-decoration: none;
  border-radius: 5px;
  margin-top: 15px;
}
.session-row {
  border-bottom: 1px solid #eee;
  padding: 8px 0;
}
.session-row:last-child {
  border-bottom: none;
}
