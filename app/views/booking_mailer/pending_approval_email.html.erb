<%= email_page :amber, icon: 'hourglass', label: 'Awaiting approval', title: 'We have received your request', tagline: @event_title,
      footer: "&copy; #{Time.now.year} EventzFlow. All rights reserved.".html_safe %>
<p>Dear <%= @booking['name'] || 'Valued Customer' %>,</p>
<p>Thank you for requesting a business matching meeting at <strong><%= @event_title %></strong>. Your booking is now <strong>awaiting approval</strong> from the host and is not yet confirmed.</p>
<%= render 'emails/details', title: 'Requested Slot', rows: [['Date', @booking_date], ['Time', @booking_time], ['Location', @booking['location']], ['Status', 'Pending approval']] %>
<% if @cancel_url.present? %>
  <%= render 'emails/buttons', primary: ['Cancel Request', @cancel_url] %>
  <p class="qrnote">Need to withdraw this request?</p>
<% end %>
<p style="margin-top:28px">We will email you as soon as the host responds. There is nothing you need to do in the meantime.</p>
<%= render 'emails/signoff', closing: 'Best regards,', name: 'The Organizing Team' %>
