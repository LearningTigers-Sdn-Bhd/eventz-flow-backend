<%= email_page :blue, icon: 'refresh', label: 'Rescheduled', title: 'Your meeting has been rescheduled', tagline: @event_title,
      footer: "&copy; #{Time.now.year} EventzFlow. All rights reserved.".html_safe %>
<p>Dear <%= @booking['name'] || 'Valued Customer' %>,</p>
<p>Your business matching session at <strong><%= @event_title %></strong> has been rescheduled. The new details are below.</p>
<%= render 'emails/details', title: 'New Booking Details', rows: [['Date', @booking_date], ['Time', @booking_time], ['Location', @booking['location']]] %>
<% if @old_date.present? && @old_time.present? %>
  <p class="qrnote" style="text-align:left;margin-top:12px">Previously scheduled for <%= @old_date.strftime('%A, %B %d, %Y') %> at <%= @old_time %>.</p>
<% end %>
<%= render 'emails/booking_actions' %>
<%= render 'emails/signoff', closing: 'Best regards,', name: 'The Organizing Team' %>
