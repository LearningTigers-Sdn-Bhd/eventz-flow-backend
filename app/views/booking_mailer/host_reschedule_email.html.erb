<%= email_page :blue, icon: 'refresh', label: 'Rescheduled', title: 'A booking has been rescheduled', tagline: @event_title,
      footer: "&copy; #{Time.now.year} EventzFlow. All rights reserved.".html_safe %>
<p>Dear <%= @host.full_name %>,</p>
<p><strong><%= @booking['name'] %></strong> has rescheduled their session with you. The new details are below.</p>
<%= render 'emails/details', title: 'New Booking Details', rows: [
      ['Date', @booking_date], ['Time', @booking_time], ['Name', @booking['name']],
      ['Email', @booking['email']], ['Phone', @booking['phone']]
    ] %>
<% if @old_date.present? && @old_time.present? %>
  <p class="qrnote" style="text-align:left;margin-top:12px">Previously scheduled for <%= @old_date.strftime('%A, %B %d, %Y') %> at <%= @old_time %>.</p>
<% end %>
<%= render 'emails/buttons', primary: ['View on EventzFlow', @dashboard_url] %>
<%= render 'emails/signoff', closing: 'Best regards,', name: 'The Organizing Team' %>
