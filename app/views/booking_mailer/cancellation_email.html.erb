<%= email_page :red, icon: 'cal-x', label: 'Cancelled', title: 'Your meeting has been cancelled', tagline: @event_title,
      footer: "&copy; #{Time.now.year} EventzFlow. All rights reserved.".html_safe %>
<p>Dear <%= @booking['name'] || 'Valued Customer' %>,</p>
<p>Your business matching session at <strong><%= @event_title %></strong> has been cancelled.</p>
<%= render 'emails/details', title: 'Cancelled Booking', rows: [['Date', @booking_date], ['Time', @booking_time]] %>
<p style="margin-top:28px">If this wasn't you, or you'd like to book a new session, please visit the event page.</p>
<%= render 'emails/signoff', closing: 'Best regards,', name: 'The Organizing Team' %>
