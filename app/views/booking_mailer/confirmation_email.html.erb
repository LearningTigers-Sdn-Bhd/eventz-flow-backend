<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <style>
    /* Email styling */
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }
    .container {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      border: 1px solid #ddd;
      border-radius: 5px;
      background-color: #f9f9f9;
    }
    .header {
      background-color: #f2f2f2;
      padding: 10px 20px;
      text-align: center;
      border-bottom: 1px solid #ddd;
    }
    .content {
      padding: 20px;
    }
    .details {
      background-color: #fff;
      border: 1px solid #eee;
      padding: 15px;
      border-radius: 5px;
    }
    .details p {
      margin: 5px 0;
    }
    .footer {
      text-align: center;
      margin-top: 20px;
      font-size: 0.9em;
      color: #777;
    }
    .button {
      display: inline-block;
      background-color: #007bff;
      color: #ffffff;
      padding: 10px 20px;
      text-decoration: none;
      border-radius: 5px;
      margin-top: 15px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Booking Confirmation for <%= @event_title %></h2>
    </div>
    <div class="content">
      <p>Dear <%= @booking['name'] || 'Valued Customer' %>,</p>
      <p>Your business matching meeting for <strong><%= @event_title %></strong> has been successfully booked!</p>

      <h3>Booking Details:</h3>
      <div class="details">
        <p><strong>Date:</strong> <%= @booking_date %></p>
        <p><strong>Time:</strong> <%= @booking_time %></p>
        <% if @booking['location'].present? %>
          <p><strong>Location:</strong> <%= @booking['location'] %></p>
        <% end %>
      </div>

      <p>
        We look forward to seeing you there!
      </p>

      <p>Best regards,<br>The Organizing Team</p>
    </div>
    <div class="footer">
      <p>&copy; <%= Time.now.year %> EventzFlow. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
