<%= email_page :slate, icon: 'list', label: 'Daily overview', title: 'Your sessions today', tagline: @date.strftime('%A, %B %d, %Y'),
      footer: "&copy; #{Time.now.year} EventzFlow. All rights reserved.".html_safe %>
<p>Dear <%= @host.full_name %>,</p>
<p>You have <strong><%= @session_count %></strong> business matching <%= @session_count == 1 ? 'session' : 'sessions' %> scheduled for today. Here is your schedule.</p>
<% @event_groups.each do |group| %>
  <%= render 'emails/details', title: group[:event_title], rows: group[:bookings].sort_by { |b| Time.zone.parse(b.booking_time) }.map { |b| [b.booking_time, "#{b.name} · #{b.email}"] } %>
  <%= render 'emails/buttons', primary: ["View #{group[:event_title]} on EventzFlow", group[:dashboard_url]] %>
<% end %>
<p style="margin-top:28px">Log in to EventzFlow to see full session details, contact information and notes.</p>
<%= render 'emails/signoff', closing: 'Best regards,', name: 'The Organizing Team' %>
