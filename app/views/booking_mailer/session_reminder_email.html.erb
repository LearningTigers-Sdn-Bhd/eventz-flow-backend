<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <style>
    <%= render 'booking_mailer/shared_styles' %>
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Your session starts in 1 hour</h2>
    </div>
    <div class="content">
      <p>Dear <%= @booking['name'] || 'Valued Customer' %>,</p>
      <p>This is a reminder that your business matching session for <strong><%= @event_title %></strong> starts soon.</p>

      <h3>Session Details:</h3>
      <div class="details">
        <p><strong>Date:</strong> <%= @booking_date %></p>
        <p><strong>Time:</strong> <%= @booking_time %></p>
        <% if @booking['location'].present? %>
          <p><strong>Location:</strong> <%= @booking['location'] %></p>
        <% end %>
      </div>

      <a href="<%= @dashboard_url %>" class="button">View Booking</a>

      <p>See you soon!</p>
    </div>
    <div class="footer">
      <p>&copy; <%= Time.now.year %> EventzFlow. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
