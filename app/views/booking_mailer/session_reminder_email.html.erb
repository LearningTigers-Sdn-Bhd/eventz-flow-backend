<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <style>
    <%= render 'booking_mailer/shared_styles' %>
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Your session starts in 1 hour</h2>
    </div>
    <div class="content">
      <p>Dear <%= @booking['name'] || 'Valued Customer' %>,</p>
      <p>This is a reminder that your business matching session for <strong><%= @event_title %></strong> starts soon.</p>

      <h3>Session Details:</h3>
      <div class="details">
        <p><strong>Date:</strong> <%= @booking_date %></p>
        <p><strong>Time:</strong> <%= @booking_time %></p>
        <% if @booking['location'].present? %>
          <p><strong>Location:</strong> <%= @booking['location'] %></p>
        <% end %>
      </div>

      <div style="margin-top: 20px;">
        <a href="<%= @dashboard_url %>" class="button">View Booking</a>
      </div>

      <% if @reschedule_url.present? || @cancel_url.present? %>
        <div style="margin-top: 25px; padding-top: 20px; border-top: 1px solid #eee; text-align: center;">
          <p style="margin: 0 0 12px 0; font-size: 13px; color: #666;">Need to change or cancel this meeting?</p>
          <% if @reschedule_url.present? %>
            <a href="<%= @reschedule_url %>" style="display: inline-block; background-color: #007bff; color: #ffffff; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-size: 14px; font-weight: 600; margin-right: 8px;">Change or Reschedule</a>
          <% end %>
          <% if @cancel_url.present? %>
            <a href="<%= @cancel_url %>" style="display: inline-block; background-color: #ffffff; color: #dc3545; border: 1px solid #dc3545; padding: 9px 18px; text-decoration: none; border-radius: 5px; font-size: 14px; font-weight: 600;">Cancel</a>
          <% end %>
        </div>
      <% end %>

      <p style="margin-top: 20px;">See you soon!</p>
    </div>
    <div class="footer">
      <p>&copy; <%= Time.now.year %> EventzFlow. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
