<%= email_page :violet, icon: 'users', label: 'Invitation', title: "You are invited as a #{@host_label}", tagline: @event_title,
      footer: "&copy; #{Time.now.year} EventzFlow. All rights reserved.".html_safe %>
<p>Hello,</p>
<p><strong><%= @inviter_name.presence || 'The event organizer' %></strong> has invited you to join as a <strong><%= @host_label %></strong> for <strong><%= @event_title %></strong><% if @session_title.present? %> (Session: <%= @session_title %>)<% end %>.</p>
<% if @custom_message.present? %>
  <div class="callout"><%= simple_format(@custom_message) %></div>
<% else %>
  <p>As a <%= @host_label %>, you can set up your profile, manage your schedule, and connect with attendees during business matching sessions.</p>
<% end %>
<%= render 'emails/buttons', primary: ['Accept invitation and join session', @invite_url] %>
<p class="qrnote">If the button does not work, copy and paste this link into your browser:<br><a class="link" href="<%= @invite_url %>" style="word-break:break-all"><%= @invite_url %></a></p>
<%= render 'emails/signoff', closing: 'Best regards,', name: 'The Organizing Team' %>
