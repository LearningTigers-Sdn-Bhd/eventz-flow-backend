<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <style>
    <%= render 'booking_mailer/shared_styles' %>
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Business Host Invitation</h2>
    </div>
    <div class="content">
      <p>Hello,</p>
      <p>
        <strong><%= @inviter_name.presence || "The event organizer" %></strong> has invited you to join as a
        <strong>Business Host</strong> for <strong><%= @event_title %></strong>
        <% if @session_title.present? %>(Session: <%= @session_title %>)<% end %>.
      </p>
      <p>
        As a Business Host, you can set up your profile, manage your schedule, and connect with attendees during business matching sessions.
      </p>
      <div style="text-align: center; margin: 30px 0;">
        <a href="<%= @invite_url %>" class="button">Accept Invitation &amp; Join Session</a>
      </div>
      <p style="font-size: 12px; color: #666; word-break: break-all;">
        If the button above does not work, copy and paste this link into your browser:<br/>
        <a href="<%= @invite_url %>"><%= @invite_url %></a>
      </p>
    </div>
    <div class="footer">
      <p>&copy; <%= Time.now.year %> EventzFlow. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
